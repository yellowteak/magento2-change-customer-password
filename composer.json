{
  "name": "yellowteak/magento2-change-customer-password",
  "description": "Magento 2 module that makes it possible to change the customer password from the admin.",
  "type": "magento2-module",
  "license": "MIT",
  "authors": [
    {
      "name": "Erwin Romkes",
      "email": "erwin@yellowteak.com",
      "homepage": "https://www.yellowteak.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "magento/framework": "^103.0",
    "magento/module-backend": "*",
    "magento/module-config": "*",
    "magento/module-customer": "*",
    "magento/module-ui": "*",
    "magento/module-user": "*"
  },
  "require-dev": {
    "magento/magento-coding-standard": "*",
    "phpunit/phpunit": "^9.6 || ^10.5"
  },
  "autoload": {
    "psr-4": { "YellowTeak\\ChangeCustomerPassword\\": "src/" },
    "files": [ "src/registration.php" ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "laminas/laminas-dependency-plugin": false,
      "magento/composer-dependency-version-audit-plugin": false,
      "magento/magento-composer-installer": false,
      "php-http/discovery": false
    },
    "sort-packages": true
  }
}
