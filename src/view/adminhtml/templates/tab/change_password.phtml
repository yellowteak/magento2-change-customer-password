use Magento\Framework\Escaper;
use Magento\Framework\View\Helper\SecureHtmlRenderer;
use YellowTeak\ChangeCustomerPassword\Block\Adminhtml\Tab\ChangePassword;

/** @var ChangePassword $block */
/** @var Escaper $escaper */
/** @var SecureHtmlRenderer $secureRenderer */

// The fields are deliberately not part of customer_form (no data-form-part): they are posted to their own
// controller by change-password.js, so saving the customer and changing the password stay independent.
?>
<div id="yellowteak-change-customer-password"
