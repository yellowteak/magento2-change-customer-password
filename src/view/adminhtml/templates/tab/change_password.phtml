    <div class="messages" data-role="messages"></div>
    <div class="fieldset-wrapper-title">
        <span class="title"><?= $escaper->escapeHtml(__('Change Password')) ?></span>
    </div>
    <div class="admin__fieldset">
        <div class="admin__field">
            <label class="admin__field-label" for="yellowteak_ccp_new_password">
                <span><?= $escaper->escapeHtml(__('New Password')) ?></span>
            </label>
            <div class="admin__field-control">
                <input type="password" id="yellowteak_ccp_new_password" data-field="new_password"
                       class="admin__control-text" autocomplete="new-password"/>
                <div class="admin__field-note">
                    <span><?= $escaper->escapeHtml(
                        __('Minimum length: %1 characters.', $block->getMinimumPasswordLength())
                    ) ?></span>
                </div>
            </div>
        </div>
        <div class="admin__field">
            <label class="admin__field-label" for="yellowteak_ccp_password_confirmation">
                <span><?= $escaper->escapeHtml(__('Password Confirmation')) ?></span>
