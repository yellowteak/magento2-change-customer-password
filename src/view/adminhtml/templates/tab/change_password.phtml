// Tab content is injected with jQuery.html(), which runs inline scripts but not x-magento-init.
$scriptString = <<<script
    require(['YellowTeak_ChangeCustomerPassword/js/change-password'], function (changePassword) {
        changePassword(document.getElementById('yellowteak-change-customer-password'));
    });
script;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false) ?>
